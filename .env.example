# Copy to .env (ignored), or pass an external file with --lm-env. Never commit keys.
ARK_API_KEY=
# Use the actual model ID or endpoint ID enabled in your Volcengine account.
DESKFRONT_LM_MODEL=
DESKFRONT_LM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DESKFRONT_LM_INTERVAL=3
DESKFRONT_LM_TIMEOUT=6
DESKFRONT_LM_MAX_REQUESTS=600
DESKFRONT_LM_CONCURRENCY=3
# Optional: reuse ARK_API_KEY from an existing external .env without copying it.
DESKFRONT_LM_ENV_FILE=
