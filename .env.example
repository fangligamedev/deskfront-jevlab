# Copy to .env (ignored), or pass an external file with --lm-env. Never commit keys.
ARK_API_KEY=
# Use the actual model ID or endpoint ID enabled in your Volcengine account.
DESKFRONT_LM_MODEL=
DESKFRONT_LM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DESKFRONT_LM_INTERVAL=3
DESKFRONT_LM_TIMEOUT=6
DESKFRONT_LM_MAX_REQUESTS=600
DESKFRONT_LM_CONCURRENCY=3
# Optional: reuse ARK_API_KEY from an existing external .env without copying it.
DESKFRONT_LM_ENV_FILE=

# Battle model provider; internal control mode remains lm for compatibility.
DESKFRONT_LM_PROVIDER=volcengine_ark
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
# Set DESKFRONT_LM_PROVIDER=typesafe_jev for JEV tactical decisions.
# Ark settings above remain dedicated to text-based level creation and reports.

# Experimental DeepSeek multi-question short answers + real token logprobs.
# DESKFRONT_LM_PROVIDER=deepseek_logprobs
# A decision round uses 3 parallel HTTP requests (tank: 2), not one request.
# max_requests caps rounds; failed requests remain visible in the call log.
